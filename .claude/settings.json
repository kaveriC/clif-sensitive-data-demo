{
  "permissions": {
    "deny": [
      "Read(./data/phi/**)",
      "Edit(./data/phi/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-pasted-rows.py",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-row-dumps.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "cleanupPeriodDays": 7
}
